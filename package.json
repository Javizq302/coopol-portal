{
  "name": "coopol-portal",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "diag": "whoami; ps -u $(whoami) -o pid,etime,args | grep -v grep | grep -iE 'node|lsnode'",
    "kill-node": "pkill -u $(whoami) -f lsnode; echo listo",
    "logs": "tail -n 50 stderr.log 2>/dev/null; ls -la; ls dist/server 2>/dev/null",
    "git-check": "git ls-remote --heads origin 2>&1 | sed 's#//[^@]*@#//***@#'"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2"
  }
}
